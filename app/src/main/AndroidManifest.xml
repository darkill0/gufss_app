<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gufsspapp">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GUFSSPApp">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity android:name=".LoginActivity" android:exported="false"/>
        <activity android:name=".TwoFactorActivity" android:exported="false"/>
        <activity android:name=".HubActivity" android:exported="false"/>
        <activity android:name=".NotificationsActivity" android:exported="false"/>
        <activity android:name=".TasksActivity" android:exported="false"/>
        <activity android:name=".DocumentsActivity" android:exported="false"/>
        <activity android:name=".DocumentViewActivity" android:exported="false"/>
        <activity android:name=".EmployeesActivity" android:exported="false"/>
        <activity android:name=".CalendarActivity" android:exported="false"/>
        <activity android:name=".AiAssistantActivity" android:exported="false"/>
        <activity android:name=".ProfileActivity" android:exported="false"/>
        <activity android:name=".AdminPanelActivity" android:exported="false"/>
    </application>
</manifest>
